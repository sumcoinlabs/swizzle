[Unit]
Description=Swizzle Celery News Worker
After=network.target redis-server.service postgresql.service
[Service]
Type=simple
User=swizzle
WorkingDirectory=/srv/swizzle/current
EnvironmentFile=/etc/swizzle.env
ExecStart=/srv/swizzle/venv/bin/celery -A config worker --loglevel=INFO --concurrency=1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
