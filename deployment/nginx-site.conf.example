# Template only: insert in the appropriate Nginx http{} context on chosen server.
# Choose a domain and obtain HTTPS certificate before opening public registration/payments.
limit_req_zone $binary_remote_addr zone=swizzle_auth:10m rate=10r/m;
server {
    listen 127.0.0.1:8081;
    server_name _;
    client_max_body_size 10m;
    location /static/ { alias /srv/swizzle/current/staticfiles/; expires 30d; access_log off; }
    location /media/ { alias /srv/swizzle/current/media/; expires 7d; }
    location ~ ^/(account/(login|register)|publisher/organization/new)/ { limit_req zone=swizzle_auth burst=5 nodelay; proxy_pass http://127.0.0.1:8011; include proxy_params; }
    location / {
        proxy_pass http://127.0.0.1:8011;
        include proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
