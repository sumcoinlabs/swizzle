# Brand can be changed after code has been written.
SITE_NAME=Working Newsroom
SITE_TAGLINE=Independent reporting and company announcements
SITE_DOMAIN=localhost
SITE_LANGUAGE=en
SITE_LOGO_URL=
SITE_ACCENT_COLOR=#076dd7

# DEV ONLY: copy to .env and generate a random key; never commit secrets.
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgresql://swizzle:swizzle@localhost:5432/swizzle

# Redis/Celery (separate processes; can share the same VM)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
NEWSROOM_AUTO_PUBLISH=false
NEWSROOM_POLL_MINUTES=15
NEWSROOM_ITEMS_PER_RUN=10

# Optional AI. Without this, feeds collect candidate stories without generation.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Stripe, optional in development; live payment flows require valid keys and webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_READER_MONTHLY_PRICE_ID=
PRESS_RELEASE_PRICE_CENTS=2900

# Optional Cloudflare Turnstile on sign-up and publisher submissions
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Ads. Actual ads.txt requires your publisher values.
ADSENSE_CLIENT_ID=
ADSENSE_SLOT_ID=
ADS_TXT=
